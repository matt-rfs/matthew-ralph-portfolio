---
interface Props {
  title: string;
  label: string;
  description: string;
  href: string;
}

const { title, label, description, href } = Astro.props;
---

<article class="project-card">
  <p class="eyebrow">{label}</p>
  <h2>{title}</h2>
  <p>{description}</p>
  <a class="text-link" href={href}>View project <span aria-hidden="true">→</span></a>
</article>
