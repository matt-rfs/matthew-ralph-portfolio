---
// What's etched on each card is literal, so it supports the label instead of needing one:
// 56 dots = 56 people; listing bars = market comparisons; a building at ~95% occupancy; a lifecycle loop; 15 account executives;
// one coach and 30 sellers; a workflow with an evidence gate and a human checkpoint.
interface Props {
  id: string;
  class?: string;
}
const { id, class: cls = 'plate__engraving' } = Astro.props;
const r = (v: number) => Math.round(v * 10) / 10;
const ring = (n: number, rad: number, cx: number, cy: number, off = 0, ry = rad) =>
  Array.from({ length: n }, (_, k) => {
    const a = (k / n) * Math.PI * 2 - Math.PI / 2 + off;
    return { x: r(cx + Math.cos(a) * rad), y: r(cy + Math.sin(a) * ry) };
  });
const people = Array.from({ length: 56 }, (_, k) => ({ x: 40 + (k % 8) * 24, y: 46 + Math.floor(k / 8) * 24 }));
const bars = [62, 88, 74, 110, 96, 132, 118, 84, 104];
const loop = ring(6, 78, 150, 122, 0, 60);
const team = Array.from({ length: 15 }, (_, k) => ({ x: 150 + (k % 5) * 34, y: 76 + Math.floor(k / 5) * 40 }));
const inner = ring(12, 42, 150, 120);
const outer = ring(18, 82, 150, 120, 0.17);
const flow = [40, 96, 152, 208, 264, 320];
// 60 windows, 3 empty: a building at ~95% occupancy
const windows = Array.from({ length: 60 }, (_, k) => ({ x: 86 + (k % 10) * 20, y: 54 + Math.floor(k / 10) * 20, empty: [7, 23, 41].includes(k) }));
---

<svg class={cls} viewBox="0 0 360 240" aria-hidden="true" focusable="false">
  {id === 'right-choice' && people.map((d) => <circle cx={d.x} cy={d.y} r="4" />)}
  {
    id === 'ralph-realty' && (
      <g>
        <line class="ln" x1="34" y1="190" x2="326" y2="190" />
        {bars.map((h, k) => <rect x={44 + k * 31} y={190 - h} width="18" height={h} rx="3" class={k === 5 ? 'hot' : 'bar'} />)}
        <circle cx={44 + 5 * 31 + 9} cy={190 - 132 - 18} r="7" class="hot" />
      </g>
    )
  }
  {
    id === 'wasatch' && (
      <g>
        <rect class="ln" x="70" y="40" width="220" height="164" rx="4" />
        {windows.map((w) => <rect x={w.x} y={w.y} width="14" height="12" rx="2" class={w.empty ? 'held' : 'bar'} />)}
        <rect x="166" y="178" width="28" height="26" rx="3" class="hot" />
      </g>
    )
  }
  {
    id === 'apex-labs' && (
      <g>
        <ellipse class="ln" cx="150" cy="122" rx="78" ry="60" />
        {loop.map((p, k) => <circle cx={p.x} cy={p.y} r={k === 0 ? 8 : 5} class={k === 0 ? 'hot' : ''} />)}
        <path class="ln" d="M196 70 l10 -1 l-4 9" />
      </g>
    )
  }
  {
    id === 'vessel-brand' && (
      <g>
        {team.map((t) => <line class="ln faint" x1="74" y1="120" x2={t.x} y2={t.y} />)}
        <circle cx="74" cy="120" r="11" class="hot" />
        {team.map((t) => <circle cx={t.x} cy={t.y} r="5" />)}
      </g>
    )
  }
  {
    id === 'visiativ' && (
      <g>
        {inner.map((p) => <line class="ln faint" x1="150" y1="120" x2={p.x} y2={p.y} />)}
        {outer.map((p, k) => {
          const q = inner[Math.floor((k * 12) / 18)];
          return <line class="ln faint" x1={q.x} y1={q.y} x2={p.x} y2={p.y} />;
        })}
        <circle cx="150" cy="120" r="10" class="hot" />
        {inner.map((p) => <circle cx={p.x} cy={p.y} r="4" />)}
        {outer.map((p) => <circle cx={p.x} cy={p.y} r="4" />)}
      </g>
    )
  }
  {
    id === 'ai-systems' && (
      <g>
        <line class="ln" x1="40" y1="104" x2="320" y2="104" />
        <path class="ln dash" d="M96 104 V180 H208" />
        <rect class="gate" x="234" y="80" width="5" height="48" rx="2" />
        {flow.map((x, k) =>
          k === 4 ? (
            <rect x={x - 10} y="94" width="20" height="20" rx="3" transform={`rotate(45 ${x} 104)`} class="hot" />
          ) : (
            <circle cx={x} cy="104" r={k === 2 ? 10 : 7} class={k === 2 ? 'ring' : ''} />
          ),
        )}
        <rect x="200" y="172" width="16" height="16" rx="3" class="held" />
      </g>
    )
  }
</svg>
