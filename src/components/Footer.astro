---
import { href } from '../lib/url';
import { projects, contact, personal } from '../data/site';
---

<footer class="foot" id="contact">
  <div class="wrap foot__grid">
    <div>
      <p class="foot__name">Matthew Ralph</p>
      <p class="foot__line">I build teams that perform. Relocating to North County San Diego; open to remote.</p>
      <p class="foot__line">{personal.offClock}</p>
      <!-- the same story with one role's work first, for people hiring for it -->
      <p class="foot__line foot__doors">
        Hiring for <a href={href('/ai/')}>AI</a> or <a href={href('/enablement/')}>enablement</a>? Here’s the same story with that work first.
      </p>
    </div>
    <nav aria-label="Case studies">
      <p class="foot__head">Case studies</p>
      <ul>
        {projects.map((p) => <li><a href={href(`/work/${p.slug}/`)}>{p.name}</a></li>)}
      </ul>
    </nav>
    <div>
      <p class="foot__head">Contact</p>
      <ul>
        <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        <li><a href={contact.linkedin} rel="noopener">LinkedIn</a></li>
        <li><a href={contact.github} rel="noopener">Work samples on GitHub</a></li>
        <li><a href={href('/Matthew_Ralph_Resume.pdf')} download>Résumé (PDF)</a></li>
      </ul>
    </div>
  </div>
  <p class="wrap foot__legal">© 2026 Matthew Ralph</p>
</footer>
